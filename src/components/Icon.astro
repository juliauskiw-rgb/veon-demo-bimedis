---
// Functional line icons, 1.5 px stroke, currentColor. Decorative: always paired with visible text or aria-label on the parent.
type Name = "whatsapp" | "viber" | "phone" | "mail" | "arrow" | "lock" | "menu" | "close" | "search" | "facebook" | "instagram" | "youtube";
interface Props { name: Name; size?: number; class?: string; }
const { name, size = 20, class: cls } = Astro.props;
---
<svg class:list={["icon", cls]} width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {name === "whatsapp" && (<>
    <path d="M4 20l1.2-3.9A8.2 8.2 0 1 1 8.3 19z" />
    <path d="M9.2 8.6c-.3.9.1 2.4 1.5 3.8s2.9 1.9 3.9 1.6l.9-1.1-1.7-.9-.8.6a4.3 4.3 0 0 1-2-2l.6-.8-.9-1.7z" />
  </>)}
  {name === "viber" && (<>
    <path d="M12 3c4.8 0 7.8 1.8 7.8 7s-3 7-7.8 7h-1.4L8 19.6V16.6C5.4 15.7 4.2 13.6 4.2 10 4.2 4.8 7.2 3 12 3z" />
    <path d="M13 7.2a3 3 0 0 1 2.8 2.8M13 9.4a.9.9 0 0 1 .7.7" />
    <path d="M9.3 8.3c-.2.8.2 2 1.2 3s2.2 1.4 3 1.2l.6-.8-1.3-.8-.6.4a3.2 3.2 0 0 1-1.6-1.6l.4-.6-.8-1.3z" />
  </>)}
  {name === "phone" && <path d="M5.5 4h3l1.6 4.2-2 1.3a11 11 0 0 0 6.4 6.4l1.3-2 4.2 1.6v3a2 2 0 0 1-2.1 2A16 16 0 0 1 3.5 6.1 2 2 0 0 1 5.5 4z" />}
  {name === "mail" && (<><rect x="3.5" y="5.5" width="17" height="13" rx="2" /><path d="M4 7l8 6 8-6" /></>)}
  {name === "arrow" && <path d="M5 12h14M13 6l6 6-6 6" />}
  {name === "lock" && (<><rect x="5" y="10.5" width="14" height="10" rx="2" /><path d="M8 10.5V8a4 4 0 0 1 8 0v2.5" /></>)}
  {name === "menu" && <path d="M4 7h16M4 12h16M4 17h16" />}
  {name === "close" && <path d="M6 6l12 12M18 6L6 18" />}
  {name === "search" && (<><circle cx="11" cy="11" r="6.5" /><path d="M16 16l4 4" /></>)}
  {name === "facebook" && <path d="M14.5 8H16V4.5h-2.2c-2.4 0-3.8 1.5-3.8 4V11H8v3.5h2V20h3.5v-5.5h2.3l.5-3.5h-2.8V9c0-.6.4-1 1-1z" />}
  {name === "instagram" && (<><rect x="4" y="4" width="16" height="16" rx="4.5" /><circle cx="12" cy="12" r="3.6" /><path d="M16.8 7.2h.01" /></>)}
  {name === "youtube" && (<><rect x="2.8" y="5.5" width="18.4" height="13" rx="3.5" /><path d="M10.2 9.3v5.4l4.6-2.7z" /></>)}
</svg>
